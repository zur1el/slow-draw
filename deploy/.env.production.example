# Production env template for draw.kodbox.mx
# Copy to `.env` on the VPS (next to docker-compose.yml).

POSTGRES_USER=draw
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=draw_game
# Optional: leave published for debugging; remove ports in compose if you want db private-only
POSTGRES_HOST_PORT=5433
WEB_HOST_PORT=3000

DATABASE_URL=postgresql://draw:change-me-strong-password@db:5432/draw_game

NEXT_PUBLIC_APP_URL=https://draw.kodbox.mx

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_or_pk_test_...
CLERK_SECRET_KEY=sk_live_or_sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kodbox.mx

CRON_SECRET=long-random-string
